# Server Configuration
PORT=8080
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aegisphish?sslmode=disable
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aegisphish
DB_PORT=5432
DB_SSLMODE=disable

# JWT Configuration
# Generate a unique secret, for example: openssl rand -base64 48
# Do not commit your real .env file or reuse a secret across environments.
JWT_SECRET=

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Email Configuration
EMAIL_FROM=noreply@aegisphish.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
